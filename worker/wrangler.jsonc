{
  "name": "x-automation-worker",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "x-automation",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      {
        "cron": "*/1 * * * *",
        "name": "tick"
      },
      {
        "cron": "0 * * * *",
        "name": "maintenance"
      },
      {
        "cron": "0 0 * * *",
        "name": "budget-reset"
      }
    ]
  }
}
