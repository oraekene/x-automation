{
  // Provision the real database before the first deploy:
  //   npm run db:create
  //   npm run db:migrate
  // then paste the returned database_id from `wrangler d1 create` into
  // d1_databases[0].database_id below.
  //
  // Cron triggers: tick (per-minute) drives automation; maintenance (hourly)
  // sweeps stale commands; a third slot is reserved for daily budget resets.
  //
  // Dashboard auth (ticket 03): set ACCESS_TEAM and ACCESS_AUD as worker
  // secrets/plaintext vars so getUser() verifies Cloudflare Access JWTs.
  // Never set AUTH_DEV in production (it trusts unsigned tokens).
  "name": "x-automation-worker",
  "compatibility_date": "2025-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "triggers": {
    "crons": [
      { "cron": "* * * * *", "name": "tick" },
      { "cron": "0 * * * *", "name": "maintenance" }
    ]
  },
  "vars": {
    "ACCESS_TEAM": "",
    "ACCESS_AUD": "",
    "AUTH_DEV": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "x-automation",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ]
}
